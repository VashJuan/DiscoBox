{
	// Edit in the repo, then copy changed files to the board.
	// The board must keep drive letter I: (see README, "Repo and board together").
	"folders": [
		{
			"name": "DiscoBox repo",
			"path": "."
		},
		{
			"name": "CIRCUITPY board (I:)",
			"path": "I:/"
		}
	],
	"settings": {
		"files.exclude": {
			"**/System Volume Information": true,
			"**/.fseventsd": true,
			"**/.Trashes": true,
			"**/.metadata_never_index": true,
			"**/__pycache__": true
		}
	}
}
